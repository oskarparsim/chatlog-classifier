          "author": {
            "role": "user"
          },
          "create_time": 1742911200.0,
          "content": {
            "content_type": "text",
            "parts": [
              "Explain the difference between INNER JOIN and LEFT JOIN with a small example. Studying for the database midterm."
            ]
          }
        }
      },
      "msg-05-1": {
        "id": "msg-05-1",
        "parent": "msg-05-0",
